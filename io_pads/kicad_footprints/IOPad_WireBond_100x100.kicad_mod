(footprint "IOPad_WireBond_100x100"
  (layer "F.Cu")
  (descr "I/O pad (wire_bond), 100x100 um. Auto-generated by gds_to_kicad/io_pads/generate_io_pad.py")
  (attr smd)

  (property "IO_CLASS" "wire_bond")
  (property "IO_PAD_SIZE_UM" "100x100")

  (fp_text reference "REF**" (at 0 0) (layer "F.SilkS")
    (effects (font (size 0.5 0.5) (thickness 0.08)))
  )
  (fp_text value "IOPad_WireBond_100x100" (at 0 -0.450) (layer "F.Fab")
    (effects (font (size 0.4 0.4) (thickness 0.06)))
  )

  (pad "1" smd rect (at 0 0)
    (size 0.100000 0.100000)
    (layers "F.Cu" "F.Mask")
  )

  (fp_rect (start -0.1000 -0.1000) (end 0.1000 0.1000)
    (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd")
  )
)
