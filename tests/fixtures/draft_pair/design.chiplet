format_version: '1.0'
assembly:
  name: cf_padring_die_cmos5l
  description: An ihp-sg13cmos5l pad-ring die built by LibreLane's stock Chip flow
    and two ihp-sg13cmos5l pad frames, admitted and flipped onto an IntM4TM2 carrier
    with wire-bond pads; the pad frames' supplies on a TopMetal1/TopMetal2 mesh
  units: um
technologies:
  intm4tm2:
    description: IHP 130nm IntM4TM2 aluminium BEOL interposer
    layer_properties: ${INTERPOSER_PDK_ROOT}/libs.tech/klayout/tech/intm4tm2.lyp
    stackup: ${CHIPLET_STUDIO_ROOT}/configs/stackups/intm4tm2.yaml
    dbu: 0.001
  sg13cmos5l:
    layer_properties: ${PDK_ROOT}/ihp-sg13cmos5l/libs.tech/klayout/tech/sg13cmos5l.lyp
    stackup: ${CHIPLET_STUDIO_ROOT}/configs/stackups/ihp-sg13cmos5l.yaml
    dbu: 0.001
components:
